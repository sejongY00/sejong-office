{
  "name": "sejong-office",
  "version": "0.1.8",
  "private": true,
  "description": "Browser-only document, diagram and viewer web app (static site)",
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sejong-office/frontend",
    "build": "npm run build -w @sejong-office/frontend",
    "test": "npm run test -w @sejong-office/frontend && npm run test -w @sejong-office/desktop",
    "preview": "npm run preview -w @sejong-office/frontend",
    "desktop:dev": "npm run dev -w @sejong-office/desktop",
    "desktop:pack": "npm run pack -w @sejong-office/desktop",
    "desktop:dist": "npm run dist -w @sejong-office/desktop",
    "sync:upstreams": "bash scripts/sync-upstreams.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
